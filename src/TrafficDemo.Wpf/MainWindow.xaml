<Window x:Class="TrafficDemo.Wpf.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:mapsui="clr-namespace:Mapsui.UI.Wpf;assembly=Mapsui.UI.Wpf" xmlns:local="clr-namespace:TrafficDemo.Wpf"
 Title="Traffic Lab · AIS + ADS-B · Mapsui" Width="1480" Height="960" MinWidth="1050" MinHeight="700" Background="#13202D" Foreground="#E2EBF3">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="9,5"/><Setter Property="Foreground" Value="#12202D"/></Style>
  <Style TargetType="TextBox"><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="4"/><Setter Property="MinWidth" Value="55"/></Style>
  <Style TargetType="TextBlock"><Setter Property="Margin" Value="3"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Margin" Value="5"/><Setter Property="Foreground" Value="#E2EBF3"/></Style>
  <Style TargetType="GroupBox"><Setter Property="Margin" Value="5"/><Setter Property="Padding" Value="5"/><Setter Property="Foreground" Value="#E2EBF3"/></Style>
  <DataTemplate DataType="{x:Type local:FilterEditor}">
   <StackPanel>
    <WrapPanel><CheckBox Content="Ships" IsChecked="{Binding Ships}"/><CheckBox Content="Aircraft" IsChecked="{Binding Aircraft}"/></WrapPanel>
    <TextBlock Text="Identity or name contains"/><TextBox Text="{Binding Search}"/>
    <TextBlock Text="Speed range (knots; blank = any)"/><UniformGrid Columns="2"><TextBox Text="{Binding MinimumSpeed}"/><TextBox Text="{Binding MaximumSpeed}"/></UniformGrid>
    <TextBlock Text="Aircraft altitude range (feet)"/><UniformGrid Columns="2"><TextBox Text="{Binding MinimumAltitude}"/><TextBox Text="{Binding MaximumAltitude}"/></UniformGrid>
    <TextBlock Text="Bounds: west,south,east,north"/><TextBox Text="{Binding Bounds}" ToolTip="Blank = anywhere. West greater than east crosses the dateline."/>
   </StackPanel>
  </DataTemplate>
 </Window.Resources>
 <DockPanel>
  <Border DockPanel.Dock="Top" Background="#1B3041" Padding="10,8">
   <DockPanel><TextBlock DockPanel.Dock="Left" Text="TRAFFIC LAB" FontSize="23" FontWeight="Bold" Margin="4,0,25,0"/>
    <TextBlock Text="AIS + ADS-B  /  synthetic traffic  /  measured Mapsui rendering" FontSize="14" VerticalAlignment="Center"/>
   </DockPanel>
  </Border>
  <Border DockPanel.Dock="Bottom" Background="#1B3041" Padding="5"><StackPanel><TextBlock Text="{Binding Status}" TextWrapping="Wrap"/><TextBlock Text="{Binding PopulationWarning}" Foreground="#FFD06A" TextWrapping="Wrap"/></StackPanel></Border>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="355" MinWidth="300"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <TabControl Grid.Column="0" Background="#162635" BorderThickness="0" Foreground="#E2EBF3">
    <TabItem Header="Simulation" Foreground="#12202D"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
     <GroupBox Header="Population and timing"><StackPanel>
      <UniformGrid Columns="2"><TextBlock Text="Ships"/><TextBlock Text="Aircraft"/><TextBox Text="{Binding Ships}"/><TextBox Text="{Binding Aircraft}"/>
       <TextBlock Text="Ship interval (s)"/><TextBlock Text="Aircraft interval (s)"/><TextBox Text="{Binding ShipInterval}"/><TextBox Text="{Binding AircraftInterval}"/>
       <TextBlock Text="Random seed"/><TextBlock Text="Simulation speed"/><TextBox Text="{Binding Seed}"/><TextBox Text="{Binding SimulationSpeed}"/></UniformGrid>
      <CheckBox Content="Dense Ionian Sea scenario" IsChecked="{Binding Dense}"/>
      <WrapPanel><Button Content="1,000" Command="{Binding PresetCommand}" CommandParameter="1000"/><Button Content="5,000" Command="{Binding PresetCommand}" CommandParameter="5000"/><Button Content="10,000" Command="{Binding PresetCommand}" CommandParameter="10000"/></WrapPanel>
      <Button Content="Apply configuration and restart" Command="{Binding ApplyConfigurationCommand}"/>
      <WrapPanel><Button Content="Start" Command="{Binding StartCommand}"/><Button Content="Pause" Command="{Binding PauseCommand}"/><Button Content="Resume" Command="{Binding ResumeCommand}"/><Button Content="Reset" Command="{Binding ResetCommand}"/></WrapPanel>
     </StackPanel></GroupBox>
     <GroupBox Header="Map and selection"><StackPanel><CheckBox Content="Show bounded traces for all visible tracks" IsChecked="{Binding ShowTraces}"/>
      <WrapPanel><Button Content="Home" Command="{Binding HomeCommand}"/><Button Content="Zoom to selected" Command="{Binding FocusCommand}"/><CheckBox Content="Follow" IsChecked="{Binding Following}"/></WrapPanel>
      <TextBlock Text="{Binding Details}" TextWrapping="Wrap"/>
     </StackPanel></GroupBox>
     <GroupBox Header="GeoServer basemap"><StackPanel>
      <ComboBox ItemsSource="{Binding BasemapLayers}" SelectedItem="{Binding BasemapLayer}" Margin="3"/><ComboBox ItemsSource="{Binding Protocols}" SelectedItem="{Binding BasemapProtocol}" Margin="3"/>
      <Button Content="Connect / retry" Command="{Binding ConnectBasemapCommand}"/><TextBlock Text="{Binding BasemapStatus}" TextWrapping="Wrap"/>
     </StackPanel></GroupBox>
    </StackPanel></ScrollViewer></TabItem>
    <TabItem Header="Filters" Foreground="#12202D"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
     <GroupBox Header="Input admission"><StackPanel><TextBlock Text="Excluded tracks are purged. Only new accepted reports rebuild their history." TextWrapping="Wrap"/><ContentControl Content="{Binding InputEditor}"/>
      <WrapPanel><Button Content="Apply input" Command="{Binding ApplyInputFilterCommand}"/><Button Content="Clear" Command="{Binding ClearInputFilterCommand}"/></WrapPanel></StackPanel></GroupBox>
     <GroupBox Header="Display only"><StackPanel><TextBlock Text="Hide symbols, traces and table rows; keep tracking and history." TextWrapping="Wrap"/><ContentControl Content="{Binding DisplayEditor}"/>
      <WrapPanel><Button Content="Apply display" Command="{Binding ApplyDisplayFilterCommand}"/><Button Content="Clear" Command="{Binding ClearDisplayFilterCommand}"/></WrapPanel></StackPanel></GroupBox>
    </StackPanel></ScrollViewer></TabItem>
    <TabItem Header="Performance" Foreground="#12202D"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="5" TextElement.Foreground="#E2EBF3">
     <TextBlock Text="{Binding Performance}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
     <TextBlock Text="Percentiles use bounded recent windows. Render time measures completed Mapsui drawing calls; it is not physical display scan-out. CPU is normalized across logical processors." TextWrapping="Wrap"/>
     <Button Content="Export current report…" Click="ExportClicked"/>
    </StackPanel></ScrollViewer></TabItem>
   </TabControl>
   <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#314556"/>
   <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="5"/><RowDefinition Height="210" MinHeight="100"/></Grid.RowDefinitions>
    <mapsui:MapControl x:Name="MapView" Grid.Row="0"/>
    <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="#314556"/>
    <DataGrid Grid.Row="2" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedTrack,Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
     EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"
     Background="#EFF3F7" Foreground="#172B3A" RowHeaderWidth="0" CanUserAddRows="False">
     <DataGrid.Columns><DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="80"/><DataGridTextColumn Header="Identity" Binding="{Binding Identity}" Width="110"/>
      <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Knots" Binding="{Binding SpeedKnots,StringFormat=F1}" Width="75"/>
      <DataGridTextColumn Header="Altitude ft" Binding="{Binding AltitudeFeet,StringFormat=N0}" Width="100"/><DataGridCheckBoxColumn Header="Stale" Binding="{Binding Stale}" Width="55"/>
     </DataGrid.Columns>
    </DataGrid>
   </Grid>
  </Grid>
 </DockPanel>
</Window>
