<Window x:Class="OgcDemo.Wpf.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mapsui="clr-namespace:Mapsui.UI.Wpf;assembly=Mapsui.UI.Wpf"
        Title="Mapsui • OGC Desktop Lab" Width="1280" Height="820" MinWidth="960" MinHeight="600" Background="#F4F7FA">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#142F43" Padding="18,12">
      <StackPanel><TextBlock Text="OGC DESKTOP LAB" FontSize="22" FontWeight="SemiBold" Foreground="White"/>
        <TextBlock Text="Mapsui + .NET 10   |   Local features and internal map services" Foreground="#B6D4E5" Margin="0,4,0,0"/></StackPanel>
    </Border>
    <StatusBar DockPanel.Dock="Bottom" Padding="8"><TextBlock Text="{Binding Status}" TextWrapping="Wrap"/></StatusBar>
    <ToolBarTray DockPanel.Dock="Top"><ToolBar>
      <Button Content="Home" Command="{Binding HomeCommand}"/><Button Content="+" Command="{Binding ZoomInCommand}"/><Button Content="−" Command="{Binding ZoomOutCommand}"/>
      <Separator/><Button Content="Open GeoJSON" Command="{Binding OpenGeoJsonCommand}"/><Button Content="Add graphics" Command="{Binding AddGraphicsCommand}"/>
      <Button Content="Clear selection" Command="{Binding ClearSelectionCommand}"/><Button Content="Refresh" Command="{Binding RefreshCommand}"/>
    </ToolBar></ToolBarTray>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="290"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
      <DockPanel Grid.Column="0" Margin="10">
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Text="INTERNAL SERVICES" FontWeight="Bold" Margin="3,6"/>
          <ComboBox ItemsSource="{Binding Services}" SelectedItem="{Binding SelectedService}" DisplayMemberPath="Name" MinHeight="28" Margin="3"/>
          <Button Content="Connect selected service" Command="{Binding ConnectCommand}"/>
          <TextBlock Text="Enable endpoints in appsettings.local.json. No public basemap is used." TextWrapping="Wrap" Margin="3,5,3,16" Foreground="#526878"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
          <TextBlock Text="Selected layer opacity" Margin="3,8"/>
          <Slider Minimum="0" Maximum="1" Value="{Binding SelectedLayer.Opacity}" TickFrequency="0.1" Margin="3"/>
          <WrapPanel><Button Content="Up" Command="{Binding MoveUpCommand}"/><Button Content="Down" Command="{Binding MoveDownCommand}"/>
            <Button Content="Zoom" Command="{Binding ZoomLayerCommand}"/><Button Content="Remove" Command="{Binding RemoveLayerCommand}"/></WrapPanel>
        </StackPanel>
        <TreeView SelectedItemChanged="LayerSelected" Background="White" BorderBrush="#DCE5EC">
          <TreeViewItem Header="Map layers (top first)" IsExpanded="True" ItemsSource="{Binding Layers}">
            <TreeViewItem.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding Enabled}" Margin="0,5"/></DataTemplate></TreeViewItem.ItemTemplate>
          </TreeViewItem>
        </TreeView>
      </DockPanel>
      <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#DCE5EC"/>
      <mapsui:MapControl Grid.Column="2" x:Name="MapView"/>
      <DockPanel Grid.Column="3" Margin="14">
        <TextBlock DockPanel.Dock="Top" Text="FEATURE DETAILS" FontWeight="Bold" Margin="0,8,0,12"/>
        <TextBox Text="{Binding Details, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="8" BorderBrush="#DCE5EC"/>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
